{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Stack Stats Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "build extension"
    },
    {
      "name": "Run Stack Stats Extension (local account server)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "build extension",
      "env": {
        "STACK_STATS_AUTH_ORIGIN": "http://localhost:3000"
      }
    }
  ]
}
