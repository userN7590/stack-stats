{
  "name": "stack-stats",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vscode": "pnpm --filter stack-stats-vscode build && node scripts/test-vscode.mjs",
    "dev:daemon": "pnpm --filter @stack-stats/daemon dev",
    "stackstats": "pnpm --filter @stack-stats/cli dev",
    "benchmark": "node --import tsx scripts/benchmark-telemetry.mts",
    "test:vscode:api": "pnpm --filter stack-stats-vscode build && node scripts/test-vscode.mjs --api-only",
    "benchmark:sync": "node --import tsx scripts/benchmark-sync.mts"
  },
  "devDependencies": {
    "@stack-stats/core": "workspace:*",
    "@stack-stats/protocol": "workspace:*",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
